<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.roomy.autoclean</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/roomy-engine</string>
	<key>ProgramArguments</key>
	<array>
		<string>roomy-engine</string>
		<string>clean</string>
		<string>--auto</string>
		<string>--if-due</string>
	</array>
	<!-- Looks every 6 hours; the engine cleans only when a run is due, so a
	     Mac that was asleep catches up soon after it wakes. -->
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
</dict>
</plist>
